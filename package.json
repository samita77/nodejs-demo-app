{
  "name": "nodejs-demo-app",
  "version": "1.0.0",
  "description": "A simple Node.js app styled with Tailwind CSS.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/styles.css --minify",
    "start": "node server.js",
    "dev": "npm run build:css && node --watch server.js",
    "test": "node --check server.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
